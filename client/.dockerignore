# Keep host-only files out of the build context. The Dockerfile installs the
# dependencies itself (Alpine/musl) and builds from the sources: anything
# installed or built on the host must not overwrite that.

# Dependencies installed on the host (different libc and native binaries)
node_modules

# Web build output and tool caches
dist
.vite
.netlify
**/*.tsbuildinfo

# Desktop app (Tauri) build output and sidecar binaries, not used by the web image
src-tauri/target
src-tauri/bin
src-tauri/sidecar
src-tauri/gen

# Local data and environment files (never bake them into an image)
.env
.env.*
**/*.csv
public/dashboard_data.json

# Editors, agent tooling, OS and logs
.vscode
.idea
.agents
**/.DS_Store
**/Thumbs.db
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
